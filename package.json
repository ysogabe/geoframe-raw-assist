{
  "name": "geoframe-raw-assist",
  "version": "0.1.0",
  "description": "旅行写真の JPEG+RAW ペアを解析し、選別と RAW 現像・ブラケット合成を支援する macOS アプリ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysogabe/geoframe-raw-assist.git"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:coreimage": "bash scripts/build-coreimage-cli.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "bench:browse:dev": "vite --config vite.browse-bench.config.ts",
    "bench:browse:build": "vite build --config vite.browse-bench.config.ts",
    "bench:browse:prod": "vite build --config vite.browse-bench.config.ts && vite preview --config vite.browse-bench.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "typescript-language-server": "^5.3.0",
    "vite": "8.0.13",
    "vitest": "5.0.2"
  },
  "type": "module"
}
