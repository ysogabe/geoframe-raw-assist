{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoFrame RAW Assist",
  "version": "0.1.0",
  "identifier": "com.geoframe.rawassist",
  "build": {
    "beforeDevCommand": "npm run build:coreimage && vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:coreimage && vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GeoFrame RAW Assist",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/coreimage/**",
          "$APPDATA/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/geoframe-ci-develop"
    ],
    "resources": {
      "../scripts/photos_import.applescript": "photos_import.applescript"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    }
  }
}
