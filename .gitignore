# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/sample/
*.tsbuildinfo
/.venv/
__pycache__/
*.py[cod]
/.claude/
/.serena/

# Google Drive OAuth client secret (personal, not for source control)
/local_raw/drive_client_secret.json

# local_raw/paths.py の Path.home() 解決失敗時フォールバック（Path.cwd()）が
# リポジトリルート配下を指しうるための保険。通常は到達しない。
# 3 プラットフォーム分の行き先をすべて塞ぐ（macOS / Linux / Windows）。
/Library/
/.local/
/AppData/

# Core Image PoC CLI (SwiftPM build output)
/native/coreimage-cli/.build/

# Core Image CLI の Tauri externalBin（scripts/build-coreimage-cli.sh が生成）
/src-tauri/binaries/
