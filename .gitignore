/node_modules

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
/dist/
/outputs/
/work/
/sample/
*.tsbuildinfo
/.venv/
__pycache__/
*.py[cod]
/.claude/
/.serena/

# 旧Python版が作った設定・出力が残る場合の誤コミット防止。
# 3 プラットフォーム分の行き先をすべて塞ぐ（macOS / Linux / Windows）。
/Library/
/.local/
/AppData/

# Core Image PoC CLI (SwiftPM build output)
/native/coreimage-cli/.build/

# Core Image CLI の Tauri externalBin（scripts/build-coreimage-cli.sh が生成）
/src-tauri/binaries/

# エージェント・エディタの個人設定（手元にだけ置く）
/CLAUDE.md
/AGENTS.md
/.omp/
